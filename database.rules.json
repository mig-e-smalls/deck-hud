{
  "rules": {
    "tables": {
      "$code": {
        "players": {
          ".read": "auth != null && $code.matches(/^r[0-9a-f]{14,40}$/)",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $code.matches(/^r[0-9a-f]{14,40}$/)",
            ".validate": "!newData.exists() || (newData.child('nick').isString() && newData.child('nick').val().length <= 20 && newData.child('deck').isString() && newData.child('deck').val().length <= 60)"
          }
        },
        "state": {
          ".read": "auth != null && $code.matches(/^r[0-9a-f]{14,40}$/)",
          ".write": "auth != null && $code.matches(/^r[0-9a-f]{14,40}$/)",
          "turn": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "monarch": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "initiative": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "dn": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
          },
          "sess": {
            ".validate": "newData.hasChildren()"
          },
          "order": {
            ".validate": "newData.hasChildren()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}